<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.research.pubmanager.controller.DashboardController"
            prefHeight="750.0" prefWidth="1200.0" stylesheets="@styles.css">

    <!-- TOP SECTION: HEADER & METRICS CARDS -->
    <top>
        <VBox spacing="15.0" styleClass="header-box" BorderPane.alignment="CENTER">
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Research Publication Verification &amp; Management System" styleClass="header-title"/>
                    <Label text="Verify scholarly papers via DOI registry (Crossref / Google Scholar metadata) and manage academic records." styleClass="header-subtitle"/>
                </VBox>
                <Button text="⟳ Refresh" onAction="#handleRefresh" styleClass="btn-secondary"/>
            </HBox>

            <!-- Metrics Summary Cards -->
            <HBox spacing="15.0">
                <VBox prefWidth="220.0" styleClass="stat-card">
                    <Label text="TOTAL PUBLICATIONS" styleClass="stat-label"/>
                    <Label fx:id="lblTotalCount" text="0" styleClass="stat-value"/>
                </VBox>
                <VBox prefWidth="220.0" styleClass="stat-card">
                    <Label text="VERIFIED" styleClass="stat-label" style="-fx-text-fill: #16a34a;"/>
                    <Label fx:id="lblVerifiedCount" text="0" styleClass="stat-value" style="-fx-text-fill: #16a34a;"/>
                </VBox>
                <VBox prefWidth="220.0" styleClass="stat-card">
                    <Label text="PENDING VERIFICATION" styleClass="stat-label" style="-fx-text-fill: #ca8a04;"/>
                    <Label fx:id="lblPendingCount" text="0" styleClass="stat-value" style="-fx-text-fill: #ca8a04;"/>
                </VBox>
                <VBox prefWidth="220.0" styleClass="stat-card">
                    <Label text="DISCREPANCY / REJECTED" styleClass="stat-label" style="-fx-text-fill: #dc2626;"/>
                    <Label fx:id="lblRejectedCount" text="0" styleClass="stat-value" style="-fx-text-fill: #dc2626;"/>
                </VBox>
            </HBox>

            <!-- Search & Actions Bar -->
            <HBox spacing="12.0" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="🔍 Search Title, Author, DOI, or Journal..." prefWidth="380.0"/>
                <ComboBox fx:id="statusFilterComboBox" prefWidth="180.0" promptText="Filter by Status"/>
                
                <Region HBox.hgrow="ALWAYS"/>

                <Button text="⚡ Fast DOI Import" onAction="#handleQuickDoiImport" styleClass="btn-success"/>
                <Button text="+ Add Publication" onAction="#handleOpenAddDialog" styleClass="btn-primary"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER SECTION: PUBLICATION TABLE -->
    <center>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="12.0" right="20.0" bottom="10.0" left="20.0"/>
            </padding>
            <TableView fx:id="publicationTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50.0"/>
                    <TableColumn fx:id="colTitle" text="Paper Title" prefWidth="320.0"/>
                    <TableColumn fx:id="colDoi" text="DOI" prefWidth="180.0"/>
                    <TableColumn fx:id="colAuthors" text="Authors" prefWidth="220.0"/>
                    <TableColumn fx:id="colYear" text="Year" prefWidth="70.0"/>
                    <TableColumn fx:id="colJournal" text="Journal / Conference" prefWidth="180.0"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="110.0"/>
                    <TableColumn fx:id="colNotes" text="Verification Notes" prefWidth="200.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <!-- BOTTOM SECTION: ACTION CONTROLS -->
    <bottom>
        <HBox spacing="12.0" alignment="CENTER_RIGHT" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="12.0" right="20.0" bottom="15.0" left="20.0"/>
            </padding>

            <Label text="Select a publication to verify or modify:" style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
            <Region HBox.hgrow="ALWAYS"/>

            <Button text="🌐 Verify Selected via Crossref" onAction="#handleVerifySelected" styleClass="btn-info"/>
            <Button text="✎ Edit" onAction="#handleEditSelected" styleClass="btn-secondary"/>
            <Button text="✔ Mark Verified" onAction="#handleMarkVerified" styleClass="btn-success"/>
            <Button text="✖ Mark Rejected" onAction="#handleMarkRejected" styleClass="btn-danger"/>
            <Button text="🗑 Delete" onAction="#handleDeleteSelected" styleClass="btn-secondary" style="-fx-text-fill: #dc2626;"/>
        </HBox>
    </bottom>
</BorderPane>
